{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "watcher": {
    "ignore": [
      "config/credentials.local.json",
      "data/pdfs/**",
      "data/official_text/**",
      "data/*.sqlite*",
      "updates/**",
      "vendor/**",
      "tmp/**",
      "runtime/**",
      "**/__pycache__/**"
    ]
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  }
}
